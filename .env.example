# Banco de dados
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Administração: senha somente como hash criado por password_hash()
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_IDLE_SECONDS=
ADMIN_SESSION_ABSOLUTE_SECONDS=
APP_SESSION_NAME=

# Operadores/clientes: operam o painel sem acesso aos logs. Lista JSON com
# usuário e hash (password_hash), nunca senha em texto puro. Vazio = só o dono.
# Ex.: [{"user":"DiromaPizzaria","hash":"$2y$12$..."}]
ADMIN_OPERATORS=

# Storage privado, obrigatoriamente fora do web root
APP_RATE_LIMIT_DIR=
APP_RATE_LIMIT_SECRET=
APP_LOG_PATH=

# Validade do contexto SameSite usado pela página pública
PUBLIC_REQUEST_CONTEXT_SECONDS=

# Proxies autorizados a informar X-Forwarded-Proto; IPs ou faixas CIDR
# separados por vírgula. Vazio significa não confiar em nenhum cabeçalho
# encaminhado. Preencha somente com o endereço real do balanceador.
APP_TRUSTED_PROXIES=

# Segredo de HMAC dos tickets públicos; use no mínimo 32 bytes aleatórios
PUBLIC_TICKET_HMAC_KEY=

# Relógio operacional centralizado
# Fuso IANA e horário de virada do ciclo no formato HH:MM.
APP_TIMEZONE=America/Sao_Paulo
APP_OPERATIONAL_CYCLE_TIME=01:30
